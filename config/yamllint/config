---
# vim:syntax=yaml

extends: default

rules:
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1

  brackets:
    min-spaces-inside: 0
    max-spaces-inside: 1

  comments:
    min-spaces-from-content: 1

  indentation:
    indent-sequences: consistent

  line-length:
    max: 200
    level: warning
