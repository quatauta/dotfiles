#!/usr/bin/env bash

(parallel --version 2>/dev/null || true) | grep -q GNU || echo "Please install gnu parallel (devbox global add parallel-full)"
touch ~/.parallel/will-cite

SRC_DIR="${1:?Please provide the source dir for photos as first parameter}"
DST_DIR="${2:-${HOME}/Pictures}"

LAST_RUN_FILE="${DST_DIR}/.$(basename "$0").last_run"
LAST_IMG="$((find "${DST_DIR}"/2* \( -iname "*.nef" -or -iname "*.jpg" -or -iname "*.mov" \) 2>/dev/null || true) | sort -r | head -n1)"

if ! [[ -r "${LAST_RUN_FILE}" ]] && [[ -z "${LAST_IMG}" ]] ; then
  echo No last run, copying all files ...
  touch -d 1900-01-01 "${LAST_RUN_FILE}"
fi

if [[ "${LAST_IMG}" -nt "${LAST_RUN_FILE}" ]]; then
  LAST_RUN="$(exiftool -if '$DateTimeOriginal' -DateTimeOriginal -d "%Y-%m-%d %H:%M:%S" -s3 "${LAST_IMG}")"
  echo "${LAST_RUN}" | tr "-" ":" >"${LAST_RUN_FILE}"
  touch -d "${LAST_RUN}" "${LAST_RUN_FILE}"
fi

LAST_RUN="$(date -r "${LAST_RUN_FILE}")"
CPU_COUNT="$(nproc || sysctl -n hw.logicalcpu)"

echo "Source:        ${SRC_DIR}"
echo "Destination:   ${DST_DIR}"
echo "Last run file: ${LAST_RUN_FILE}"
echo "Last image:    ${LAST_IMG}"
echo "Last run:      ${LAST_RUN}"
echo

TMP_OUT="$(mktemp -q)"
trap 'rm -f "${TMP_OUT}" &>/dev/null' EXIT

(
  find "${SRC_DIR}" \( \( -iname "*.nef" -or -iname "*.jpg" -or -iname "*.mov" \) -newer "${LAST_RUN_FILE}" \! -ipath '*reject*' \) -print0 2>/dev/null |
  parallel -0 -j "${CPU_COUNT}" -N100 --keep-order --quote \
    exiftool --fast2 -q -p $'${FilePath}\t'"${DST_DIR}"$'/${CreateDate;DateFmt("%Y/%m/%d/")}${Filename}' |
  sort -z |
  while IFS=$'\t' read -r src dst; do
    echo -ne "mkdir -pv '$(dirname "${dst}")' ; /bin/cp -cv '${src}' '${dst}'\0"
  done |
  xargs -0rn1 -P"${CPU_COUNT}" bash -c
) &>"${TMP_OUT}" &

# Print copy output in a 5-line rolling window
CMD_PID=$!
TMP_OUT_LINES="5"
printf '\n%.0s' $(seq 0 $(($TMP_OUT_LINES - 1)) )
while true; do
  sleep 0.3
  mapfile -t -n "${TMP_OUT_LINES}" lines < <(tail -n "${TMP_OUT_LINES}" "${TMP_OUT}")
  buf=$'\e['"${TMP_OUT_LINES}"'A'
  for i in $( seq 0 $(($TMP_OUT_LINES - 1)) ) ; do
    buf+=$'\e[2K'"${lines[$i]}"$'\n'
  done
  printf '%s' "$buf"
  kill -0 $CMD_PID 2>/dev/null || break
done

date +"%Y:%m:%d %H:%M:%S" >"${LAST_RUN_FILE}"
